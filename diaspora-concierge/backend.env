# Diaspora Concierge backend — optional configuration.
#
# YOU DO NOT NEED TO EDIT THIS FILE TO GET STARTED. The app runs with everything blank, and the
# admin panel works on your local network right away (username admin@diasporaconcierge.app,
# password = the app password shown on this app's page in the Umbrel dashboard).
#
# Edit this only to connect payment providers. After any change: Umbrel dashboard ->
# Diaspora Concierge -> (three dots) -> Restart.
#
# JWT_SECRET, DATABASE_URL and the admin login are set automatically — do NOT add them here.
#
# Each group below is all-or-nothing: fill in every line of a group, or leave it fully blank.
# A half-filled group stops the backend from starting (the app log names the missing line).

# ── Public internet access ──────────────────────────────────────────────────────────────────
# Install the "Cloudflare Tunnel" app from the Umbrel App Store, paste its connector token there,
# and in the Cloudflare dashboard add a public hostname:
#     api.<your domain>  ->  HTTP  ->  diaspora-concierge_backend_1:4000
# Then set PUBLIC_BASE_URL below. Nothing Cloudflare-related goes in THIS file.
PUBLIC_BASE_URL=

# ── BTCPay Server (Bitcoin) ─────────────────────────────────────────────────────────────────
# Running on this same Umbrel: BTCPAY_URL is the local address, e.g. http://btcpay-server_web_1
# (no public URL needed). API key: BTCPay -> Account -> Manage Account -> API Keys, scoped to
# cancreateinvoice, canviewinvoices, cancreatepullpayments, cancreatetransactions.
# Store ID: Store Settings -> General. Webhook secret: Store Settings -> Webhooks.
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# ── PayPal ──────────────────────────────────────────────────────────────────────────────────
# developer.paypal.com -> Apps & Credentials. Set PAYPAL_ENV=live once ready.
# Webhook: point it at https://api.<your domain>/api/webhooks/paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# ── Paynow (Zimbabwe) ───────────────────────────────────────────────────────────────────────
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# ── USDT on Ethereum (chain scanning) ───────────────────────────────────────────────────────
# Optional — a public RPC endpoint override. Leave blank to use the built-in fallback list.
ETH_RPC_URL=

# ── Mapbox (distance-based delivery pricing) ────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── Alert emails (early warning when something goes down) ──────────────────────────────────
# Sent when disk usage, BTCPay reachability/version, QVAC drift, or the database goes from
# healthy to bad — and again when it recovers. Leave fully blank to skip emails (the checks
# still run and still show in the admin panel either way). Any SMTP provider works, e.g. a
# Gmail account with an App Password (myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-character app password>   SMTP_FROM=you@gmail.com
# ALERT_EMAIL_TO is who receives the alerts — can be the same address as SMTP_USER.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# ── Other (optional overrides — uncomment only if you need to change the default) ────────────
# Platform commission as a fraction. Default is 0.12 (12%).
# PLATFORM_COMMISSION_PERCENT=0.12
# Comma-separated browser origins allowed to call the API (only if you add a web client — the
# mobile apps send no Origin and aren't subject to CORS).
# CORS_ORIGINS=https://app.example.com
