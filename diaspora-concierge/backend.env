# Diaspora Concierge backend — runtime configuration.
#
# This file was copied into the app's data directory when you installed the app. Edit it here,
# then restart the app from the Umbrel dashboard for changes to take effect:
#
#   Umbrel dashboard -> Diaspora Concierge -> (three dots) -> Restart
#
# JWT_SECRET and DATABASE_URL are set automatically by the app and must NOT be added here.
#
# Each payment / integration group below is all-or-nothing: fill in every line of a group to
# enable it, or leave the whole group blank to disable it. A half-filled group stops the backend
# from starting (it will say exactly which line is missing in the app logs).

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────────────────────
# Create a tunnel at one.dash.cloudflare.com -> Networks -> Tunnels -> Create a tunnel
# (choose "Cloudflared"). Copy the token from the install command it shows you (the long string
# after "--token"). Then add a Public Hostname on that tunnel:
#     Subdomain: api    Domain: <your domain>    Service: HTTP  ->  diaspora-concierge_backend_1:4000
TUNNEL_TOKEN=

# ── BTCPay Server (Bitcoin) ──────────────────────────────────────────────────────────────────
# Running on this same Umbrel: BTCPAY_URL is the local address, e.g. http://btcpay-server_web_1
# (no public URL needed). API key: BTCPay -> Account -> Manage Account -> API Keys, scoped to
# cancreateinvoice, canviewinvoices, cancreatepullpayments, cancreatetransactions.
# Store ID: Store Settings -> General. Webhook secret: Store Settings -> Webhooks.
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# ── PayPal ───────────────────────────────────────────────────────────────────────────────────
# developer.paypal.com -> Apps & Credentials. Set PAYPAL_ENV=live once ready.
# Webhook: point it at https://api.<your domain>/api/webhooks/paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# ── Paynow (Zimbabwe) ────────────────────────────────────────────────────────────────────────
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# ── USDT on Ethereum (chain scanning) ────────────────────────────────────────────────────────
# Optional — a public RPC endpoint override. Leave blank to use the built-in fallback list.
ETH_RPC_URL=

# ── Mapbox (distance-based delivery pricing) ─────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── Other ────────────────────────────────────────────────────────────────────────────────────
# This backend's own public URL (no trailing slash) — needed for Paynow's per-payment
# result/return URLs. Set once your Cloudflare hostname is live.
PUBLIC_BASE_URL=
# Platform commission as a fraction (0.12 = 12%). Leave blank for the 12% default.
PLATFORM_COMMISSION_PERCENT=
# Comma-separated browser origins allowed to call the API (only needed if you add a web client;
# the mobile apps don't use CORS).
CORS_ORIGINS=
