# Diaspora Concierge backend — optional configuration.
#
# YOU DO NOT NEED TO EDIT THIS FILE TO GET STARTED. The app runs with everything blank, and the
# admin panel works on your local network right away (username admin@diasporaconcierge.app,
# password = the app password shown on this app's page in the Umbrel dashboard).
#
# Edit this only to (a) publish the backend to the internet via Cloudflare Tunnel, or
# (b) connect payment providers. After any change: Umbrel dashboard -> Diaspora Concierge ->
# (three dots) -> Restart.
#
# JWT_SECRET, DATABASE_URL and the admin login are set automatically — do NOT add them here.
#
# Each payment group below is all-or-nothing: fill in every line of a group, or leave it fully
# blank. A half-filled group stops the backend from starting (the app log names the missing line).

# ── Cloudflare Tunnel (publishes the backend at https://api.diasporaconcierge.app) ───────────
# In the Cloudflare "cloudflared" tunnel screen, copy the long token (the string after
# "service install" / "--token"). Paste it here as one unbroken line, no quotes:
TUNNEL_TOKEN=

# ── BTCPay Server (Bitcoin) ──────────────────────────────────────────────────────────────────
# Running on this same Umbrel: BTCPAY_URL is the local address, e.g. http://btcpay-server_web_1
# (no public URL needed). API key: BTCPay -> Account -> Manage Account -> API Keys, scoped to
# cancreateinvoice, canviewinvoices, cancreatepullpayments, cancreatetransactions.
# Store ID: Store Settings -> General. Webhook secret: Store Settings -> Webhooks.
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# ── PayPal ───────────────────────────────────────────────────────────────────────────────────
# developer.paypal.com -> Apps & Credentials. Set PAYPAL_ENV=live once ready.
# Webhook: point it at https://api.<your domain>/api/webhooks/paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# ── Paynow (Zimbabwe) ────────────────────────────────────────────────────────────────────────
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# ── USDT on Ethereum (chain scanning) ────────────────────────────────────────────────────────
# Optional — a public RPC endpoint override. Leave blank to use the built-in fallback list.
ETH_RPC_URL=

# ── Mapbox (distance-based delivery pricing) ─────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── Other ────────────────────────────────────────────────────────────────────────────────────
# This backend's own public URL (no trailing slash) — needed for Paynow's per-payment
# result/return URLs. Set once your Cloudflare hostname is live.
PUBLIC_BASE_URL=
# Platform commission as a fraction (0.12 = 12%). Leave blank for the 12% default.
PLATFORM_COMMISSION_PERCENT=
# Comma-separated browser origins allowed to call the API (only needed if you add a web client;
# the mobile apps don't use CORS).
CORS_ORIGINS=
